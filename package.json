{
	"name": "product-finder",
	"version": "0.1.0",
	"description": "A Gutenberg-native product finder for WooCommerce block-theme stores.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"files": [
		"build",
		"includes",
		"vendor",
		"product-finder.php",
		"readme.txt"
	],
	"scripts": {
		"build": "cross-env WP_EXPERIMENTAL_MODULES=true wp-scripts build --webpack-copy-php --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "cross-env WP_EXPERIMENTAL_MODULES=true wp-scripts start --webpack-copy-php --blocks-manifest",
		"env": "wp-env",
		"postinstall": "node scripts/fix-wp-env-dns.js",
		"test:php": "wp-env run cli bash -c \"cd /var/www/html/wp-content/plugins/product-finder && vendor/bin/phpunit\"",
		"composer": "wp-env run cli bash -c \"cd /var/www/html/wp-content/plugins/product-finder && composer\"",
		"seed": "wp-env run cli wp eval-file wp-content/plugins/product-finder/scripts/seed-tents.php",
		"test:php:integration": "wp-env run tests-cli bash -c \"cd /var/www/html/wp-content/plugins/product-finder && vendor/bin/phpunit -c phpunit-integration.xml\"",
		"test:js": "wp-scripts test-unit-js",
		"package": "npm run build && wp-env run cli bash -c \"cd /var/www/html/wp-content/plugins/product-finder && composer install --no-dev --optimize-autoloader\" && wp-scripts plugin-zip"
	},
	"dependencies": {
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/i18n": "latest",
		"@wordpress/interactivity": "latest"
	},
	"devDependencies": {
		"@wordpress/env": "^11.12.0",
		"@wordpress/scripts": "^34.0.0",
		"cross-env": "^10.1.0"
	}
}
